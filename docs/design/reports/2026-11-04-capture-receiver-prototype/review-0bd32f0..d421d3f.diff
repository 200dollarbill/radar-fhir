+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Raw signal capture</title>
+<style>
+  body { font-family: system-ui, sans-serif; max-width: 52rem; margin: 1rem auto; padding: 0 1rem; }
+  textarea { width: 100%; height: 6rem; font-family: monospace; }
+  canvas { width: 100%; height: 200px; border: 1px solid #888; background: #fafafa; }
+  #simulated { background: #b00020; color: #fff; font-size: 2rem; font-weight: bold; text-align: center; padding: .5rem; margin: .5rem 0; }
+  #error { color: #b00020; font-weight: bold; min-height: 1.5rem; }
+  #notes { color: #444; }
+  [hidden] { display: none !important; }
+</style>
+</head>
+<body>
+<h1>Raw signal capture</h1>
+<p><strong>Raw signal only. Not a measurement result or a clinical finding.</strong></p>
+
+<section>
+  <label for="card">Session card</label>
+  <textarea id="card" spellcheck="false"></textarea>
+  <button id="use-card">Use card</button>
+  <span id="card-label"></span>
+</section>
+
+<section>
+  <button id="connect">Connect serial</button>
+  <button id="simulate">Start simulator</button>
+  <button id="stop" disabled>Stop</button>
+</section>
+
+<div id="simulated" hidden>SIMULATED</div>
+<canvas id="plot" width="1000" height="200"></canvas>
+<p id="status">Samples 0 | Chunks confirmed 0 | Chunks pending 0 | Gaps 0 | Rejected lines 0</p>
+<p id="notes"></p>
+<p id="error" role="alert"></p>
+<script type="module" src="app.js"></script>
+</body>
+</html>
