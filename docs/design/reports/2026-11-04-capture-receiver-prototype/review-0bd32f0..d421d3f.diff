diff --git a/receiver/src/capture.js b/receiver/src/capture.js
new file mode 100644
index 0000000..98166ab
--- /dev/null
+++ b/receiver/src/capture.js
@@ -0,0 +1,97 @@
+// Capture controller: serial/simulated lines -> samples -> chunks -> outbox.
+// Stop is done by the caller ending the line source.
+import { parseLine } from "./jsonlines.js";
+import { Chunker } from "./chunker.js";
+import { buildObservation, identifierValue } from "./observation.js";
+
+const MAX_FILL = 999; // mirrors Chunker: a larger gap starts a new segment
+
+const isQuota = (e) => e?.name === "QuotaExceededError";
+
+export class Capture {
+  constructor({ outbox, sessionKey, card, source, onSample, onStatus, newId = () => "cap-" + crypto.randomUUID() }) {
+    Object.assign(this, { outbox, sessionKey, card, source, onSample, onStatus, newId });
+    this.stats = { samples: 0, gaps: 0, rejected: 0 };
+  }
+
+  _emit() {
+    this.onStatus?.({ ...this.stats });
+  }
+
+  async run(lines) {
+    const captureId = this.newId();
+    this.stats = { samples: 0, gaps: 0, rejected: 0 };
+    let failure = null;
+    let chain = Promise.resolve();
+    const chunker = new Chunker({
+      onChunk: (chunk) => {
+        chain = chain.then(async () => {
+          if (failure) return;
+          try {
+            await this.outbox.add({
+              identifier: identifierValue(captureId, chunk),
+              sessionKey: this.sessionKey,
+              observation: buildObservation(chunk, this.card, { captureId, source: this.source }),
+            });
+          } catch (e) {
+            failure = e;
+          }
+        });
+      },
+    });
+
+    let result = "ended";
+    let lastIdx = null;
+    let lastFs = null;
+    let procError = null;
+    let finished = false;
+    const it = lines[Symbol.asyncIterator]();
+    // Only a failure of the line source itself counts as a disconnect.
+    for (;;) {
+      let step;
+      try {
+        step = await it.next();
+      } catch {
+        result = "disconnected";
+        finished = true;
+        break;
+      }
+      if (step.done) { finished = true; break; }
+      try {
+        const r = parseLine(step.value);
+        if (r.kind === "sample") {
+          const s = r.sample;
+          if (lastIdx !== null && s.fs === lastFs) {
+            const gap = s.sampleIdx - lastIdx - 1;
+            if (gap > 0 && gap <= MAX_FILL) this.stats.gaps += gap;
+          }
+          lastIdx = s.sampleIdx;
+          lastFs = s.fs;
+          this.stats.samples += 1;
+          chunker.addSample(s);
+          this.onSample?.(s);
+          this._emit();
+        } else if (r.kind === "rejected") {
+          this.stats.rejected += 1;
+          chunker.noteRejected();
+          this._emit();
+        }
+      } catch (e) {
+        procError = e;
+        break;
+      }
+      if (failure) break;
+    }
+    if (!finished) {
+      try { await it.return?.(); } catch { /* source cleanup failure is not actionable */ }
+    }
+    if (!failure) chunker.flush();
+    await chain;
+    if (procError) throw procError;
+    if (failure) {
+      if (isQuota(failure)) return "quota";
+      throw failure;
+    }
+    return result;
+  }
+}
diff --git a/receiver/src/card.js b/receiver/src/card.js
new file mode 100644
index 0000000..db8c6c9
--- /dev/null
+++ b/receiver/src/card.js
@@ -0,0 +1,32 @@
+// Parse the session card printed by the server's capture-session command.
+
+const REQUIRED = ["token", "patient", "encounter", "device", "org", "label"];
+const PREFIXES = { patient: "Patient/", encounter: "Encounter/", device: "Device/" };
+
+export function parseCard(text) {
+  if (typeof text !== "string" || text.trim() === "") {
+    throw new Error("Paste the session card printed by the server first.");
+  }
+  let card;
+  try {
+    card = JSON.parse(text);
+  } catch {
+    throw new Error("The session card is not valid JSON.");
+  }
+  if (card === null || typeof card !== "object" || Array.isArray(card)) {
+    throw new Error("The session card must be a JSON object.");
+  }
+  for (const f of REQUIRED) {
+    if (!(f in card)) throw new Error(`Session card is missing field ${f}.`);
+    if (typeof card[f] !== "string" || card[f] === "") {
+      throw new Error(`Session card field ${f} must be a non-empty string.`);
+    }
+  }
+  for (const [f, prefix] of Object.entries(PREFIXES)) {
+    if (!card[f].startsWith(prefix) || card[f].length === prefix.length) {
+      throw new Error(`Session card field ${f} must start with ${prefix}`);
+    }
+  }
+  const { token, patient, encounter, device, org, label } = card;
+  return { token, patient, encounter, device, org, label };
+}
diff --git a/receiver/src/chunker.js b/receiver/src/chunker.js
new file mode 100644
index 0000000..b00e982
--- /dev/null
+++ b/receiver/src/chunker.js
@@ -0,0 +1,88 @@
+// Group samples into chunks of at most chunkSize entries per channel.
+// A gap inside a chunk is filled with "E" so the sample clock stays regular.
+// Plain ES module: runs unchanged in the browser and in Node.
+
+export const CHANNELS = ["I", "Q", "ax", "ay", "az", "gx", "gy", "gz"];
+const MAX_FILL = 999; // a larger gap starts a new segment
+
+export class Chunker {
+  constructor({ chunkSize = 1000, now = Date.now, onChunk } = {}) {
+    this.chunkSize = chunkSize;
+    this.now = now;
+    this.onChunk = onChunk;
+    this.segment = 0;
+    this.chunkIndex = 0;
+    this.lastIdx = null;
+    this.fs = null;
+    this.pendingRejected = 0;
+    this.deviceMissed = 0;
+    this._reset();
+  }
+
+  _reset() {
+    this.channels = Object.fromEntries(CHANNELS.map((c) => [c, []]));
+    this.gapSamples = 0;
+    this.startTimeMs = null;
+  }
+
+  noteRejected() {
+    this.pendingRejected += 1;
+  }
+
+  // `remaining` = fill entries still to add before the current real sample,
+  // counting the entry being added now when it is a fill.
+  _begin(remaining) {
+    if (this.startTimeMs === null) {
+      this.startTimeMs = this.now() - remaining * (1000 / this.fs);
+    }
+  }
+
+  _emitIfFull() {
+    if (this.channels.I.length >= this.chunkSize) this.flush();
+  }
+
+  addSample(sample) {
+    if (this.lastIdx !== null) {
+      const gap = sample.sampleIdx - this.lastIdx - 1;
+      if (gap < 0 || gap > MAX_FILL || sample.fs !== this.fs) {
+        this.flush();
+        this.segment += 1;
+        this.chunkIndex = 0;
+        this.lastIdx = null;
+      }
+    }
+    this.fs = sample.fs;
+    this.deviceMissed = sample.missed;
+    if (this.lastIdx !== null) {
+      const gap = sample.sampleIdx - this.lastIdx - 1;
+      for (let i = 0; i < gap; i++) {
+        this._begin(gap - i);
+        for (const c of CHANNELS) this.channels[c].push("E");
+        this.gapSamples += 1;
+        this._emitIfFull();
+      }
+    }
+    this._begin(0);
+    for (const c of CHANNELS) this.channels[c].push(sample[c]);
+    this.lastIdx = sample.sampleIdx;
+    this._emitIfFull();
+  }
+
+  flush() {
+    if (this.channels.I.length === 0) return;
+    const chunk = {
+      segment: this.segment,
+      chunkIndex: this.chunkIndex,
+      fs: this.fs,
+      startTimeMs: this.startTimeMs,
+      channels: this.channels,
+      gapSamples: this.gapSamples,
+      rejectedLines: this.pendingRejected,
+      deviceMissed: this.deviceMissed,
+    };
+    this.chunkIndex += 1;
+    this.pendingRejected = 0;
+    this._reset();
+    this.onChunk(chunk);
+  }
+}
diff --git a/receiver/src/coalesce.js b/receiver/src/coalesce.js
new file mode 100644
index 0000000..1d915af
--- /dev/null
+++ b/receiver/src/coalesce.js
@@ -0,0 +1,21 @@
+// Returns schedule(): runs async fn at most once per ms, never two at once.
+// Calls made while a run or timer is pending collapse into one later run.
+export function coalesce(fn, ms, { setTimer = setTimeout } = {}) {
+  let timer = null;
+  let running = false;
+  let dirty = false;
+  const arm = () => {
+    if (timer !== null || running) return;
+    timer = setTimer(fire, ms);
+  };
+  async function fire() {
+    timer = null;
+    running = true;
+    dirty = false;
+    try { await fn(); } finally {
+      running = false;
+      if (dirty) arm();
+    }
+  }
+  return () => { dirty = true; arm(); };
+}
diff --git a/receiver/src/jsonlines.js b/receiver/src/jsonlines.js
new file mode 100644
index 0000000..163eac8
--- /dev/null
+++ b/receiver/src/jsonlines.js
@@ -0,0 +1,68 @@
+// Parse the newline-delimited JSON the radar_json firmware prints on serial.
+// Plain ES module: runs unchanged in the browser and in Node.
+
+export const FIELDS = [
+  "epoch_id", "sample_idx", "t_host_unix", "fs", "crc_ok", "missed",
+  "I", "Q", "ax", "ay", "az", "gx", "gy", "gz",
+];
+const INT_FIELDS = ["epoch_id", "sample_idx", "fs", "missed"];
+const NUM_FIELDS = ["t_host_unix", "I", "Q", "ax", "ay", "az", "gx", "gy", "gz"];
+
+const MAX_LINE = 4096;
+
+const rejected = (reason) => ({ kind: "rejected", reason });
+
+export function parseLine(line) {
+  const text = String(line).trim();
+  if (!text.startsWith("{")) return { kind: "ignored" };
+  let p;
+  try {
+    p = JSON.parse(text);
+  } catch {
+    return rejected("invalid JSON");
+  }
+  if (p === null || typeof p !== "object" || Array.isArray(p)) {
+    return rejected("packet must be a JSON object");
+  }
+  for (const f of FIELDS) {
+    if (!(f in p)) return rejected(`missing field ${f}`);
+  }
+  for (const f of INT_FIELDS) {
+    if (!Number.isInteger(p[f])) return rejected(`field ${f} must be an integer`);
+  }
+  if (typeof p.crc_ok !== "boolean") return rejected("field crc_ok must be boolean");
+  for (const f of NUM_FIELDS) {
+    if (typeof p[f] !== "number" || !Number.isFinite(p[f])) {
+      return rejected(`field ${f} must be a finite number`);
+    }
+  }
+  if (p.sample_idx < 0) return rejected("sample_idx must be >= 0");
+  if (p.fs <= 0) return rejected("fs must be > 0");
+  if (!p.crc_ok) return rejected("crc_ok is false");
+  return {
+    kind: "sample",
+    sample: {
+      sampleIdx: p.sample_idx, fs: p.fs, missed: p.missed,
+      I: p.I, Q: p.Q, ax: p.ax, ay: p.ay, az: p.az, gx: p.gx, gy: p.gy, gz: p.gz,
+    },
+  };
+}
+
+// Reassembles lines from arbitrary text chunks (serial reads split anywhere).
+export class LineSplitter {
+  constructor() {
+    this.buf = "";
+  }
+
+  push(text) {
+    this.buf += text;
+    const parts = this.buf.split("\n");
+    this.buf = parts.pop();
+    const out = parts.map((l) => (l.endsWith("\r") ? l.slice(0, -1) : l));
+    if (this.buf.length > MAX_LINE) {
+      out.push(this.buf);
+      this.buf = "";
+    }
+    return out;
+  }
+}
diff --git a/receiver/src/observation.js b/receiver/src/observation.js
new file mode 100644
index 0000000..9c972aa
--- /dev/null
+++ b/receiver/src/observation.js
@@ -0,0 +1,53 @@
+// Build the FHIR R4 raw-capture Observation for one chunk.
+// Numbers use JavaScript number-to-string; "E" marks a filled gap.
+
+const SYSTEM = "urn:prata:radar-signal";
+const UCUM = "http://unitsofmeasure.org";
+
+const COMPONENTS = [
+  ["I", "i-voltage", "V"], ["Q", "q-voltage", "V"],
+  ["ax", "accel-x", "[g]"], ["ay", "accel-y", "[g]"], ["az", "accel-z", "[g]"],
+  ["gx", "gyro-x", "deg/s"], ["gy", "gyro-y", "deg/s"], ["gz", "gyro-z", "deg/s"],
+];
+
+export function identifierValue(captureId, chunk) {
+  return `${captureId}-${chunk.segment}-${chunk.chunkIndex}`;
+}
+
+function isoSeconds(ms) {
+  return new Date(Math.floor(ms / 1000) * 1000).toISOString().replace(/\.\d+Z$/, "+00:00");
+}
+
+export function buildObservation(chunk, card, { captureId, source }) {
+  const period = 1000 / chunk.fs;
+  return {
+    resourceType: "Observation",
+    status: "final",
+    identifier: [{
+      system: `http://sys-ids.kemkes.go.id/organization/${card.org}`,
+      value: identifierValue(captureId, chunk),
+    }],
+    code: { coding: [{ system: SYSTEM, code: "raw-capture", display: "Raw radar I/Q capture" }] },
+    subject: { reference: card.patient },
+    encounter: { reference: card.encounter },
+    device: { reference: card.device },
+    effectiveDateTime: isoSeconds(chunk.startTimeMs),
+    note: [{
+      text: JSON.stringify({
+        source,
+        gap_samples: chunk.gapSamples,
+        rejected_lines: chunk.rejectedLines,
+        device_missed: chunk.deviceMissed,
+      }),
+    }],
+    component: COMPONENTS.map(([ch, code, unit]) => ({
+      code: { coding: [{ system: SYSTEM, code }] },
+      valueSampledData: {
+        origin: { value: 0, unit, system: UCUM, code: unit },
+        period,
+        dimensions: 1,
+        data: chunk.channels[ch].map(String).join(" "),
+      },
+    })),
+  };
+}
diff --git a/receiver/src/outbox.js b/receiver/src/outbox.js
new file mode 100644
index 0000000..9281284
--- /dev/null
+++ b/receiver/src/outbox.js
@@ -0,0 +1,85 @@
+// Durable outbox: records stay until the server confirms them (see uploader.js).
+// Store interface: put(record) -> id, update(record), delete(id), all() -> record[] in id order.
+// Store methods may be sync or async; Outbox awaits them.
+
+export function sessionKey(card) {
+  return `${card.patient}|${card.device}`;
+}
+
+export class MemoryStore {
+  constructor() { this._rows = new Map(); this._next = 1; }
+  put(record) {
+    const id = this._next++;
+    this._rows.set(id, { ...record, id });
+    return id;
+  }
+  update(record) { this._rows.set(record.id, { ...record }); }
+  delete(id) { this._rows.delete(id); }
+  all() { return [...this._rows.values()].sort((a, b) => a.id - b.id); }
+}
+
+export class IndexedDbStore {
+  constructor(dbName = "prata-capture") {
+    this._dbName = dbName;
+    this._db = null;
+  }
+
+  async _open() {
+    if (this._db) return this._db;
+    this._db = await new Promise((resolve, reject) => {
+      const req = indexedDB.open(this._dbName, 1);
+      req.onupgradeneeded = () => req.result.createObjectStore("outbox", { keyPath: "id", autoIncrement: true });
+      req.onsuccess = () => resolve(req.result);
+      req.onerror = () => reject(req.error);
+    });
+    try { await navigator.storage?.persist?.(); } catch { /* refusal is fine */ }
+    return this._db;
+  }
+
+  async _tx(mode, fn) {
+    const db = await this._open();
+    return new Promise((resolve, reject) => {
+      const tx = db.transaction("outbox", mode);
+      const req = fn(tx.objectStore("outbox"));
+      tx.oncomplete = () => resolve(req.result);
+      tx.onerror = () => reject(tx.error);
+      tx.onabort = () => reject(tx.error);
+    });
+  }
+
+  put(record) { const { id, ...rest } = record; return this._tx("readwrite", (s) => s.add(rest)); }
+  update(record) { return this._tx("readwrite", (s) => s.put(record)); }
+  delete(id) { return this._tx("readwrite", (s) => s.delete(id)); }
+  all() { return this._tx("readonly", (s) => s.getAll()); }
+}
+
+export class Outbox {
+  constructor(store) { this.store = store; }
+
+  async add({ identifier, sessionKey: key, observation }) {
+    return await this.store.put({ identifier, sessionKey: key, observation, rejected: false, reason: null });
+  }
+
+  async nextFor(key) {
+    const rows = await this.store.all();
+    return rows.find((r) => r.sessionKey === key && !r.rejected) ?? null;
+  }
+
+  async remove(id) { await this.store.delete(id); }
+
+  async markRejected(id, reason) {
+    const row = (await this.store.all()).find((r) => r.id === id);
+    if (!row) return;
+    await this.store.update({ ...row, rejected: true, reason });
+  }
+
+  async counts(key) {
+    const c = { pending: 0, rejected: 0, otherSession: 0 };
+    for (const r of await this.store.all()) {
+      if (r.sessionKey !== key) c.otherSession++;
+      else if (r.rejected) c.rejected++;
+      else c.pending++;
+    }
+    return c;
+  }
+}
diff --git a/receiver/src/plot.js b/receiver/src/plot.js
new file mode 100644
index 0000000..db8fcc2
--- /dev/null
+++ b/receiver/src/plot.js
@@ -0,0 +1,48 @@
+// Rolling trace of the I and Q voltages. Pure maths in Trace; draw() only paints.
+
+export class Trace {
+  constructor(capacity = 1000) {
+    this.capacity = capacity;
+    this.i = [];
+    this.q = [];
+  }
+
+  push(i, q) {
+    this.i.push(i);
+    this.q.push(q);
+    if (this.i.length > this.capacity) {
+      this.i.shift();
+      this.q.shift();
+    }
+  }
+
+  // Each series is scaled to its own range, so the shape is visible at any offset.
+  points(width, height) {
+    return { i: scale(this.i, this.capacity, width, height), q: scale(this.q, this.capacity, width, height) };
+  }
+}
+
+function scale(values, capacity, width, height) {
+  if (values.length === 0) return [];
+  const lo = Math.min(...values);
+  const hi = Math.max(...values);
+  const span = hi - lo;
+  const step = capacity > 1 ? width / (capacity - 1) : 0;
+  return values.map((v, n) => {
+    const frac = span > 0 ? (v - lo) / span : 0.5; // constant signal: draw mid-height
+    return [n * step, height - frac * height];
+  });
+}
+
+export function draw(canvas, trace) {
+  const ctx = canvas.getContext("2d");
+  const { width, height } = canvas;
+  ctx.clearRect(0, 0, width, height);
+  const p = trace.points(width, height);
+  for (const [pts, colour] of [[p.i, "#1b6ec2"], [p.q, "#c2571b"]]) {
+    ctx.strokeStyle = colour;
+    ctx.beginPath();
+    pts.forEach(([x, y], n) => (n === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y)));
+    ctx.stroke();
+  }
+}
diff --git a/receiver/src/serial.js b/receiver/src/serial.js
new file mode 100644
index 0000000..190f7b9
--- /dev/null
+++ b/receiver/src/serial.js
@@ -0,0 +1,26 @@
+// Web Serial line source. Yields text lines until the signal aborts or the device is lost.
+import { LineSplitter } from "./jsonlines.js";
+
+export async function* serialLines(port, { baudRate = 115200, signal } = {}) {
+  await port.open({ baudRate });
+  const decoder = new TextDecoderStream();
+  // Keep the pipe promise: the port stays locked until the pipe has finished closing.
+  const piped = port.readable.pipeTo(decoder.writable).catch(() => {});
+  const reader = decoder.readable.getReader();
+  const stop = () => { reader.cancel().catch(() => {}); };
+  signal?.addEventListener("abort", stop, { once: true });
+  if (signal?.aborted) stop();
+  const splitter = new LineSplitter();
+  try {
+    for (;;) {
+      const { value, done } = await reader.read(); // a device-lost error propagates
+      if (done) return;
+      for (const line of splitter.push(value)) yield line;
+    }
+  } finally {
+    signal?.removeEventListener("abort", stop);
+    try { await reader.cancel(); } catch { /* already closed or errored */ }
+    await piped; // readable is unlocked now, so close() can succeed
+    try { await port.close(); } catch { /* device may be gone */ }
+  }
+}
diff --git a/receiver/src/simulator.js b/receiver/src/simulator.js
new file mode 100644
index 0000000..0b5b765
--- /dev/null
+++ b/receiver/src/simulator.js
@@ -0,0 +1,48 @@
+// Simulated device: yields the same lines the firmware prints.
+import { FIELDS } from "./jsonlines.js";
+
+export function formatLine(sampleIdx, fs, values) {
+  const v = { missed: 0, I: 1.65, Q: 1.65, ax: 0, ay: 0, az: 1, gx: 0, gy: 0, gz: 0, ...values };
+  const f6 = (x) => Number(x).toFixed(6);
+  const rec = {
+    epoch_id: 0, sample_idx: sampleIdx, t_host_unix: "0.000", fs, crc_ok: "true", missed: v.missed,
+    I: f6(v.I), Q: f6(v.Q), ax: f6(v.ax), ay: f6(v.ay), az: f6(v.az),
+    gx: f6(v.gx), gy: f6(v.gy), gz: f6(v.gz),
+  };
+  return "{" + FIELDS.map((k) => `"${k}":${rec[k]}`).join(",") + "}";
+}
+
+function defaultSleep(ms, signal) {
+  return new Promise((resolve) => {
+    const done = () => { clearTimeout(timer); signal?.removeEventListener("abort", done); resolve(); };
+    const timer = setTimeout(done, ms);
+    signal?.addEventListener("abort", done, { once: true });
+  });
+}
+
+// Respiration sine + pulse + small noise, as phase of the I/Q vector.
+function phaseAt(t) {
+  const resp = 0.8 * Math.sin(2 * Math.PI * 0.25 * t);
+  const pulse = 0.15 * Math.sin(2 * Math.PI * 1.2 * t);
+  const noise = (Math.random() - 0.5) * 0.02;
+  return resp + pulse + noise;
+}
+
+export async function* simulatorLines({ fs = 100, now = Date.now, sleep, signal } = {}) {
+  const wait = sleep ?? ((ms) => defaultSleep(ms, signal));
+  const start = now();
+  let emitted = 0;
+  while (!signal?.aborted) {
+    const due = Math.floor(((now() - start) / 1000) * fs) - emitted;
+    for (let n = 0; n < due; n++) {
+      if (signal?.aborted) return;
+      const phase = phaseAt(emitted / fs);
+      yield formatLine(emitted, fs, {
+        I: 1.65 + 0.4 * Math.cos(phase + 0.6),
+        Q: 1.65 + 0.4 * Math.sin(phase + 0.6),
+      });
+      emitted++;
+    }
+    await wait(20);
+  }
+}
diff --git a/receiver/src/uploader.js b/receiver/src/uploader.js
new file mode 100644
index 0000000..422da4f
--- /dev/null
+++ b/receiver/src/uploader.js
@@ -0,0 +1,106 @@
+// Sends outbox records one at a time. A record is deleted only after 200 or 201.
+
+import { sessionKey } from "./outbox.js";
+
+const BACKOFF_MS = [1000, 2000, 4000, 8000, 16000, 30000];
+const IDLE_MS = 500;
+
+export class Uploader {
+  constructor({ outbox, fetchFn, card, sleep, onStatus, baseUrl = "/fhir-r4/v1" }) {
+    this.outbox = outbox;
+    this.fetchFn = fetchFn;
+    this.card = card;
+    this.sleep = sleep ?? ((ms) => new Promise((r) => setTimeout(r, ms)));
+    this.onStatus = onStatus ?? (() => {});
+    this.baseUrl = baseUrl;
+    this.confirmed = 0;
+    this.lastRejectedReason = null;
+    this.failures = 0;
+    this.paused = false;
+    this.running = false;
+  }
+
+  _status(state) {
+    this.onStatus({ state, confirmed: this.confirmed, lastRejectedReason: this.lastRejectedReason });
+  }
+
+  async step() {
+    if (this.paused) return "auth";
+    const rec = await this.outbox.nextFor(sessionKey(this.card));
+    if (!rec) { this._status("idle"); return "idle"; }
+    this._status("sending");
+
+    let res;
+    try {
+      res = await this.fetchFn(`${this.baseUrl}/Observation`, {
+        method: "POST",
+        headers: {
+          Authorization: `Bearer ${this.card.token}`,
+          "Content-Type": "application/fhir+json",
+          Accept: "application/fhir+json",
+          "If-None-Exist": `identifier=${rec.identifier}`,
+        },
+        body: JSON.stringify(rec.observation),
+      });
+    } catch {
+      return await this._retry();
+    }
+
+    if (res.status === 200 || res.status === 201) {
+      await this.outbox.remove(rec.id);
+      this.confirmed++;
+      this.failures = 0;
+      this._status("sending");
+      return "sent";
+    }
+    if (res.status === 401 || res.status === 403) {
+      this.paused = true;
+      this._status("auth");
+      return "auth";
+    }
+    if (res.status >= 500) return await this._retry();
+
+    // Other 4xx (and anything unexpected): keep the record, mark it rejected.
+    const reason = await this._reason(res);
+    await this.outbox.markRejected(rec.id, reason);
+    this.lastRejectedReason = reason;
+    this._status("sending");
+    return "rejected";
+  }
+
+  async _reason(res) {
+    try {
+      const oo = JSON.parse(await res.text());
+      const text = (oo.issue ?? []).map((i) => i?.details?.text).find((t) => typeof t === "string" && t);
+      if (text) return text;
+    } catch { /* fall through */ }
+    return `HTTP ${res.status}`;
+  }
+
+  async _retry() {
+    const delay = BACKOFF_MS[Math.min(this.failures, BACKOFF_MS.length - 1)];
+    this.failures++;
+    this._status("retry");
+    await this.sleep(delay);
+    return "retry";
+  }
+
+  start() {
+    if (this.running) return;
+    this.running = true;
+    (async () => {
+      while (this.running) {
+        const r = await this.step();
+        if (r === "idle" || r === "auth") await this.sleep(IDLE_MS);
+      }
+    })();
+  }
+
+  stop() { this.running = false; }
+
+  resume(card) {
+    this.card = card;
+    this.paused = false;
+    this.failures = 0;
+  }
+}
diff --git a/receiver/tests/capture.test.js b/receiver/tests/capture.test.js
new file mode 100644
index 0000000..3af8c6d
--- /dev/null
+++ b/receiver/tests/capture.test.js
@@ -0,0 +1,101 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { Capture } from "../src/capture.js";
+import { Outbox, MemoryStore, sessionKey } from "../src/outbox.js";
+import { formatLine } from "../src/simulator.js";
+
+const card = {
+  token: "t", patient: "Patient/p1", encounter: "Encounter/e1",
+  device: "Device/d1", org: "org1", label: "L",
+};
+
+async function* gen(items, thenThrow) {
+  for (const x of items) yield x;
+  if (thenThrow) throw thenThrow;
+}
+const lines = (idxs) => idxs.map((i) => formatLine(i, 100, {}));
+
+function make(extra = {}) {
+  const store = new MemoryStore();
+  const outbox = new Outbox(store);
+  const samples = [];
+  let n = 0;
+  const cap = new Capture({
+    outbox, sessionKey: sessionKey(card), card, source: "SIMULATED",
+    onSample: (s) => samples.push(s), newId: () => "cap-" + ++n, ...extra,
+  });
+  return { store, outbox, cap, samples };
+}
+
+test("lines reach onSample and the outbox", async () => {
+  const { cap, samples, store } = make();
+  await cap.run(gen(lines([0, 1, 2])));
+  assert.equal(samples.length, 3);
+  assert.equal(store.all().length, 1);
+});
+
+test("every chunk is in the outbox before run resolves", async () => {
+  const slow = new Outbox(new MemoryStore());
+  const orig = slow.add.bind(slow);
+  slow.add = async (r) => { await new Promise((r2) => setTimeout(r2, 5)); return orig(r); };
+  const { cap } = make({ outbox: slow });
+  await cap.run(gen(lines(Array.from({ length: 2500 }, (_, i) => i))));
+  const rows = slow.store.all();
+  assert.equal(rows.length, 3);
+  assert.deepEqual(rows.map((r) => r.identifier.split("-").pop()), ["0", "1", "2"]);
+});
+
+test("ending the iterable flushes the partial chunk and returns ended", async () => {
+  const { cap, store } = make();
+  assert.equal(await cap.run(gen(lines([0, 1]))), "ended");
+  assert.equal(store.all().length, 1);
+});
+
+test("the iterable throwing flushes and returns disconnected", async () => {
+  const { cap, store } = make();
+  assert.equal(await cap.run(gen(lines([0, 1]), new Error("unplugged"))), "disconnected");
+  assert.equal(store.all().length, 1);
+});
+
+test("store quota error stops reading and returns quota", async () => {
+  const outbox = new Outbox(new MemoryStore());
+  outbox.add = async () => { throw new DOMException("full", "QuotaExceededError"); };
+  let consumed = 0;
+  async function* src() { for (let i = 0; i < 5000; i++) { consumed++; yield* lines([i]); } }
+  const { cap } = make({ outbox });
+  assert.equal(await cap.run(src()), "quota");
+  assert.ok(consumed < 5000);
+});
+
+test("each run has a new captureId", async () => {
+  const { cap, store } = make();
+  await cap.run(gen(lines([0])));
+  await cap.run(gen(lines([0])));
+  const ids = store.all().map((r) => r.identifier);
+  assert.equal(ids.length, 2);
+  assert.notEqual(ids[0], ids[1]);
+  assert.match(ids[0], /^cap-1-/);
+});
+
+test("stats count samples, gaps and rejected lines", async () => {
+  const seen = [];
+  const { cap } = make({ onStatus: (s) => seen.push({ ...s }) });
+  await cap.run(gen([...lines([0, 1]), "{bad", "banner text", ...lines([4])]));
+  assert.deepEqual(cap.stats, { samples: 3, gaps: 2, rejected: 1 });
+  assert.deepEqual(seen.at(-1), cap.stats);
+});
+
+test("rejected line followed by the next index produces an E gap", async () => {
+  const { cap, store } = make();
+  await cap.run(gen([...lines([0]), '{"bad":1}', ...lines([2])]));
+  const obs = store.all()[0].observation;
+  assert.equal(obs.component[0].valueSampledData.data.split(" ")[1], "E");
+  assert.match(obs.note[0].text, /"rejected_lines":1/);
+});
+
+test("a throwing onSample rejects run() instead of reporting disconnected", async () => {
+  const boom = new Error("ui bug");
+  const { cap, store } = make({ onSample: () => { throw boom; } });
+  await assert.rejects(cap.run(gen(lines([0, 1]))), (e) => e === boom);
+  assert.equal(store.all().length, 1);
+});
