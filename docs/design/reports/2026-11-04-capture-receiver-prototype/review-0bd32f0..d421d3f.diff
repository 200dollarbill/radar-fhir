diff --git a/receiver/tests/chunker.test.js b/receiver/tests/chunker.test.js
new file mode 100644
index 0000000..689cd10
--- /dev/null
+++ b/receiver/tests/chunker.test.js
@@ -0,0 +1,185 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { Chunker } from "../src/chunker.js";
+
+const s = (idx, o = {}) => ({
+  sampleIdx: idx, fs: 100, missed: 0,
+  I: 1, Q: 2, ax: 0, ay: 0, az: 1, gx: 0, gy: 0, gz: 0, ...o,
+});
+function make(opts = {}) {
+  const chunks = [];
+  const c = new Chunker({ now: () => 1_000_000, onChunk: (k) => chunks.push(k), ...opts });
+  return { c, chunks };
+}
+const feed = (c, from, n) => { for (let i = 0; i < n; i++) c.addSample(s(from + i)); };
+
+test("1000 samples emit one chunk; chunk 2 gets index 1", () => {
+  const { c, chunks } = make();
+  feed(c, 0, 1000);
+  assert.equal(chunks.length, 1);
+  assert.equal(chunks[0].chunkIndex, 0);
+  assert.equal(chunks[0].segment, 0);
+  assert.equal(chunks[0].channels.I.length, 1000);
+  feed(c, 1000, 1000);
+  assert.equal(chunks.length, 2);
+  assert.equal(chunks[1].chunkIndex, 1);
+});
+
+test("gap of 3 fills 3 E in every channel and counts gapSamples 3", () => {
+  const { c, chunks } = make();
+  feed(c, 0, 2);
+  c.addSample(s(5));
+  c.flush();
+  const k = chunks[0];
+  assert.deepEqual(k.channels.I, [1, 1, "E", "E", "E", 1]);
+  for (const ch of Object.values(k.channels)) assert.equal(ch.length, 6);
+  assert.deepEqual(k.channels.gz, [0, 0, "E", "E", "E", 0]);
+  assert.equal(k.gapSamples, 3);
+});
+
+test("gap crossing a chunk boundary: both chunks 1000 long, none lost", () => {
+  const { c, chunks } = make();
+  feed(c, 0, 998);
+  c.addSample(s(1003)); // gap of 5: 2 fill fill the chunk, 3 start the next
+  feed(c, 1004, 996);
+  assert.equal(chunks.length, 2);
+  assert.equal(chunks[0].channels.I.length, 1000);
+  assert.equal(chunks[1].channels.I.length, 1000);
+  assert.equal(chunks[0].gapSamples, 2);
+  assert.equal(chunks[1].gapSamples, 3);
+  assert.deepEqual(chunks[1].channels.I.slice(0, 4), ["E", "E", "E", 1]);
+  assert.equal(chunks[0].segment, chunks[1].segment);
+});
+
+test("gap of 999 fills; gap of 1000 starts a new segment", () => {
+  const a = make();
+  a.c.addSample(s(0));
+  a.c.addSample(s(1000)); // gap 999
+  assert.equal(a.chunks.length, 1); // 1 + 999 fill = 1000 -> emitted
+  a.c.flush();
+  assert.equal(a.chunks.length, 2);
+  assert.equal(a.chunks[0].gapSamples, 999);
+  assert.equal(a.chunks[1].segment, 0);
+
+  const b = make();
+  b.c.addSample(s(0));
+  b.c.addSample(s(1001)); // gap 1000
+  b.c.flush();
+  assert.equal(b.chunks.length, 2);
+  assert.equal(b.chunks[0].channels.I.length, 1);
+  assert.equal(b.chunks[1].segment, 1);
+  assert.equal(b.chunks[1].chunkIndex, 0);
+  assert.equal(b.chunks[1].gapSamples, 0);
+});
+
+test("sample_idx going backwards flushes and starts segment+1, chunkIndex 0", () => {
+  const { c, chunks } = make();
+  feed(c, 10, 5);
+  feed(c, 0, 3);
+  c.flush();
+  assert.equal(chunks.length, 2);
+  assert.equal(chunks[0].channels.I.length, 5);
+  assert.equal(chunks[1].segment, 1);
+  assert.equal(chunks[1].chunkIndex, 0);
+  assert.equal(chunks[1].channels.I.length, 3);
+});
+
+test("repeated sample_idx starts a new segment", () => {
+  const { c, chunks } = make();
+  c.addSample(s(4));
+  c.addSample(s(4));
+  c.flush();
+  assert.equal(chunks.length, 2);
+  assert.equal(chunks[1].segment, 1);
+});
+
+test("fs change flushes and starts a new segment", () => {
+  const { c, chunks } = make();
+  feed(c, 0, 3);
+  c.addSample(s(3, { fs: 250 }));
+  c.flush();
+  assert.equal(chunks.length, 2);
+  assert.equal(chunks[0].fs, 100);
+  assert.equal(chunks[1].fs, 250);
+  assert.equal(chunks[1].segment, 1);
+  assert.equal(chunks[1].gapSamples, 0);
+});
+
+test("first sample at any index causes no gap", () => {
+  const { c, chunks } = make();
+  c.addSample(s(123456));
+  c.flush();
+  assert.equal(chunks[0].channels.I.length, 1);
+  assert.equal(chunks[0].gapSamples, 0);
+  assert.equal(chunks[0].segment, 0);
+});
+
+test("flush emits a partial chunk; flush with nothing emits nothing", () => {
+  const { c, chunks } = make();
+  c.flush();
+  assert.equal(chunks.length, 0);
+  feed(c, 0, 7);
+  c.flush();
+  assert.equal(chunks.length, 1);
+  assert.equal(chunks[0].channels.Q.length, 7);
+  c.flush();
+  assert.equal(chunks.length, 1);
+});
+
+test("noteRejected counts on the next emitted chunk, then resets", () => {
+  const { c, chunks } = make();
+  c.noteRejected(); c.noteRejected();
+  feed(c, 0, 2);
+  c.flush();
+  feed(c, 2, 2);
+  c.flush();
+  assert.equal(chunks[0].rejectedLines, 2);
+  assert.equal(chunks[1].rejectedLines, 0);
+});
+
+test("rejected count survives an empty flush", () => {
+  const { c, chunks } = make();
+  c.noteRejected();
+  c.flush();
+  assert.equal(chunks.length, 0);
+  feed(c, 0, 1);
+  c.flush();
+  assert.equal(chunks[0].rejectedLines, 1);
+});
+
+test("all channels have equal length in every emitted chunk", () => {
+  const { c, chunks } = make({ chunkSize: 10 });
+  feed(c, 0, 7);
+  c.addSample(s(30));
+  feed(c, 31, 5);
+  c.flush();
+  assert.ok(chunks.length >= 3);
+  for (const k of chunks) {
+    const lens = new Set(Object.values(k.channels).map((a) => a.length));
+    assert.equal(lens.size, 1);
+    assert.deepEqual(Object.keys(k.channels), ["I", "Q", "ax", "ay", "az", "gx", "gy", "gz"]);
+  }
+});
+
+test("deviceMissed is the latest sample's missed", () => {
+  const { c, chunks } = make();
+  c.addSample(s(0, { missed: 2 }));
+  c.addSample(s(1, { missed: 5 }));
+  c.flush();
+  assert.equal(chunks[0].deviceMissed, 5);
+});
+
+test("startTimeMs back-dates by leading gap entries", () => {
+  const { c, chunks } = make({ chunkSize: 4 });
+  feed(c, 0, 3);
+  c.addSample(s(8)); // last idx 2, so gap 5
+  c.flush();
+  // chunk 2 begins with 4 fill entries, 1 fill + real? see below
+  // chunk 1: samples 0,1,2 + fill -> full. chunk 2: 4 fill -> full. chunk 3: real.
+  assert.equal(chunks.length, 3);
+  assert.equal(chunks[0].startTimeMs, 1_000_000);
+  // chunk 2 first entry is a fill with 4 fill entries remaining (incl. itself): 4 * 10 ms
+  // gap = 8 - 2 - 1 = 5; 1 went to chunk 1; 4 remain.
+  assert.equal(chunks[1].startTimeMs, 1_000_000 - 40);
+  assert.equal(chunks[2].startTimeMs, 1_000_000);
+});
diff --git a/receiver/tests/coalesce.test.js b/receiver/tests/coalesce.test.js
new file mode 100644
index 0000000..ba7ffa4
--- /dev/null
+++ b/receiver/tests/coalesce.test.js
@@ -0,0 +1,42 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { coalesce } from "../src/coalesce.js";
+
+function fakeTimers() {
+  const pending = [];
+  return { setTimer: (f) => { pending.push(f); return pending.length; }, pending };
+}
+
+test("many calls before the timer fires run fn once", async () => {
+  const t = fakeTimers();
+  let n = 0;
+  const schedule = coalesce(async () => { n++; }, 250, t);
+  for (let k = 0; k < 100; k++) schedule();
+  assert.equal(t.pending.length, 1);
+  await t.pending.shift()();
+  assert.equal(n, 1);
+  assert.equal(t.pending.length, 0);
+});
+
+test("never runs two at once; a call during a run triggers one later run", async () => {
+  const t = fakeTimers();
+  let active = 0, maxActive = 0, runs = 0;
+  let release;
+  const schedule = coalesce(async () => {
+    runs++; active++; maxActive = Math.max(maxActive, active);
+    await new Promise((r) => { release = r; });
+    active--;
+  }, 250, t);
+  schedule();
+  const first = t.pending.shift()();
+  schedule(); schedule();
+  assert.equal(t.pending.length, 0);
+  release();
+  await first;
+  assert.equal(t.pending.length, 1);
+  const second = t.pending.shift()();
+  release();
+  await second;
+  assert.equal(runs, 2);
+  assert.equal(maxActive, 1);
+});
diff --git a/receiver/tests/fixtures/make_chunk.mjs b/receiver/tests/fixtures/make_chunk.mjs
new file mode 100644
index 0000000..1a10ccc
--- /dev/null
+++ b/receiver/tests/fixtures/make_chunk.mjs
@@ -0,0 +1,37 @@
+// Usage: node make_chunk.mjs '<card JSON>'
+// Prints {"observation", "identifier", "expected"} for one chunk that includes a gap.
+// Lines go through formatLine, the real parser, the real chunker and the real builder.
+import { formatLine } from "../../src/simulator.js";
+import { parseLine } from "../../src/jsonlines.js";
+import { Chunker } from "../../src/chunker.js";
+import { buildObservation, identifierValue } from "../../src/observation.js";
+
+const card = JSON.parse(process.argv[2]);
+const captureId = "cap-e2e-fixture";
+const FS = 100;
+const GAP = [10, 11]; // sample indexes the "device" never sent
+const N = 20;
+const CHANNELS = ["I", "Q", "ax", "ay", "az", "gx", "gy", "gz"];
+
+const chunks = [];
+const chunker = new Chunker({ now: () => 1_700_000_000_000, onChunk: (c) => chunks.push(c) });
+const expected = Object.fromEntries(CHANNELS.map((c) => [c, []]));
+
+for (let i = 0; i < N; i++) {
+  const values = { I: 1.5 + i * 0.01, Q: 1.8 - i * 0.01, ax: 0.1 * i, ay: -0.05 * i, az: 1, gx: i, gy: -i, gz: 0 };
+  if (GAP.includes(i)) {
+    for (const c of CHANNELS) expected[c].push("E");
+    continue;
+  }
+  // Expected tokens come from the wire format (6 decimals) independently of the chunker.
+  for (const c of CHANNELS) expected[c].push(String(Number(values[c].toFixed(6))));
+  const parsed = parseLine(formatLine(i, FS, values));
+  if (parsed.kind !== "sample") throw new Error(`line ${i} not a sample`);
+  chunker.addSample(parsed.sample);
+}
+chunker.flush();
+if (chunks.length !== 1) throw new Error(`expected 1 chunk, got ${chunks.length}`);
+
+const observation = buildObservation(chunks[0], card, { captureId, source: "SIMULATED" });
+const identifier = `http://sys-ids.kemkes.go.id/organization/${card.org}|${identifierValue(captureId, chunks[0])}`;
+console.log(JSON.stringify({ observation, identifier, expected }));
